<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Linux head (ADR-0013). Sits on O-view.App exactly as the WPF head does; the
       accounting logic, the poll loop and the platform seams are all shared, and what
       lives here is the Linux face: a StatusNotifierItem over D-Bus, a Skia rasteriser for
       the shared tray geometry, freedesktop notifications, and the XDG portal theme.

       ADR-0005's "zero third-party runtime dependencies" is scoped to the Windows head
       (ADR-0013). This one takes Avalonia and its closure — measured at 25 managed
       assemblies plus libSkiaSharp and libHarfBuzz. That is a property of the platform:
       Linux has no first-party tray and no first-party rasteriser. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OView.Linux</RootNamespace>
    <AssemblyName>o-view</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Stamped by the release workflow from the tag, as the Windows head is. -->
    <Version>0.0.0</Version>
    <!-- No console window behind the tray icon. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <!-- Both already arrive transitively through Avalonia; referenced explicitly because
         this project uses them directly, and pinned to Avalonia's own versions so the
         restore cannot resolve a downgrade.

         Bumping either on its own breaks the Linux build. SkiaSharp is a managed wrapper
         over a native libSkiaSharp that Avalonia ships, so moving the managed half alone
         leaves the two disagreeing at runtime — SkiaSharp 4.151.1 against Avalonia 12.1.1
         failed every tray-icon render with a TypeInitializationException, and the Windows
         CI leg stayed green because it does not build this project (#117).

         Move them WITH Avalonia, never before it: bump Avalonia, then read the versions
         out of avalonia.skia.nuspec and avalonia.freedesktop.nuspec and set all three
         together. .github/dependabot.yml ignores these two packages so the bot stops
         proposing it — that ignore and this comment are one decision in two places. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\O-view.Core\O-view.Core.csproj" />
    <ProjectReference Include="..\O-view.App\O-view.App.csproj" />
  </ItemGroup>

</Project>
