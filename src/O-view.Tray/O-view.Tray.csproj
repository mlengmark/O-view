<Project Sdk="Microsoft.NET.Sdk">

  <!-- UseWindowsForms exists solely for the first-party NotifyIcon (ADR-0005).
       WinForms controls, forms, and Application.Run are off-limits (CLAUDE.md rule 5). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OView.Tray</RootNamespace>
    <!-- Stamped so the running build knows its own version for the update check (ADR-0009).
         Local/dev builds keep 0.0.0 (older than any release, so they never nag to update);
         the release workflow overrides it with the tag via -p:Version=<tag>. -->
    <Version>0.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe / window icon (Explorer, Alt-Tab, installer). This is the static brand
         mark; the *tray* icon is rendered live at runtime by IconRenderer and is
         unaffected by this (CLAUDE.md rule 5). Multi-resolution .ico: 16-256. -->
    <ApplicationIcon>..\..\brand\o-view.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file publish settings live here, not only in the release workflow, so a
       local publish and a CI publish cannot drift apart.
       IncludeNativeLibrariesForSelfExtract is load-bearing: WPF ships native DLLs
       (wpfgfx, PresentationNative, D3DCompiler) plus e_sqlite3, and without it
       PublishSingleFile leaves them beside the exe. Shipping the exe alone then
       crashes at launch with 0xC000041D - verified before the first release. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\O-view.Core\O-view.Core.csproj" />
    <ProjectReference Include="..\O-view.App\O-view.App.csproj" />
  </ItemGroup>

</Project>
