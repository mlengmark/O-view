<Window x:Class="OView.Tray.Popup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OView.Tray.Popup"
        xmlns:text="clr-namespace:OView.Presentation.Text;assembly=O-view.Presentation"
        xmlns:panel="clr-namespace:OView.Presentation.Panel;assembly=O-view.Presentation"
        xmlns:rendering="clr-namespace:OView.App.Rendering;assembly=O-view.App"
        Width="{x:Static rendering:PanelMetrics.PanelWidthDip}" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <!-- The shared hover card, so the chart's bars carry the panel's own branding
                 instead of falling back to system chrome. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HoverCard.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A text disclosure. A Button rather than a clickable TextBlock: it keeps keyboard
                 focus and Space/Enter activation, which a MouseLeftButtonUp handler silently
                 does not. -->
            <Style x:Key="DisclosureButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="Content" Opacity="0.75"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Content" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Content" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The off-plan banner's hide control. A Button, for keyboard focus and
                 Space/Enter. Full strength under the pointer or the keyboard,
                 at once rather than eased, so nothing about pressing it lags. -->
            <Style x:Key="BannerHideButton" TargetType="Button">
                <Setter Property="Width" Value="{x:Static rendering:PanelMetrics.BannerHideSizeDip}"/>
                <Setter Property="Height" Value="{x:Static rendering:PanelMetrics.BannerHideSizeDip}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="0,7,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <Path x:Name="Mark" Width="9" Height="9"
                                      Data="M0.9,0.9 L8.1,8.1 M8.1,0.9 L0.9,8.1"
                                      Stroke="{DynamicResource WarnText}" StrokeThickness="1.44"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Opacity="{x:Static rendering:PanelMetrics.BannerHideOpacity}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The flip tag: names the face a press turns to, and is flush with the block's top
                 right corner. Its mark is the tile's two arrows, at the drawing's strength. -->
            <Style x:Key="FlipTagButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="FontSize" Value="{x:Static rendering:PanelMetrics.FlipTagFontSize}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Pill" Background="{DynamicResource TileBg}" CornerRadius="4"/>
                                <!-- A layer, because a setter cannot fade: the block's hover cue
                                     drives its opacity from code, for the reason the switch's is. -->
                                <Border x:Name="HoverFill" Background="{DynamicResource BarTrack}"
                                        CornerRadius="4" Opacity="0"/>
                                <StackPanel Orientation="Horizontal" Margin="6,1">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <Path x:Name="Mark"
                                          Data="M0,2.5 L8,2.5 M5.6,0.4 L8,2.5 L5.6,4.6 M8,7.5 L0,7.5 M2.4,5.4 L0,7.5 L2.4,9.6"
                                          Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Opacity="0.8" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource TilePressed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One segment of the Output | Overall switch. Templated off
                 RadioButton so the group keeps exclusivity, arrow-key traversal and the
                 correct accessibility role; the bullet is replaced, not hidden, because a
                 collapsed bullet still reserves its width and shifts the label. -->
            <Style x:Key="ViewSwitchButton" TargetType="RadioButton">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <!-- A layer, because a setter cannot fade: its opacity is driven
                                     from code (PopupLocalBlock.UpdateHoverFill), the only place
                                     that can ask Windows whether animations are on. -->
                                <Border x:Name="HoverFill" Background="{DynamicResource TileHover}"
                                        CornerRadius="3" Opacity="0" SnapsToDevicePixels="True"/>
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               FontSize="{TemplateBinding FontSize}"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                </Trigger>
                                <!-- Checked wins over hover: it is state, not feedback, and a
                                     hover that repaints the selected segment reads as though
                                     the selection moved with the pointer. The lit fill itself
                                     is MeasureHighlight, one element behind both segments,
                                     so that it can slide between them. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource TilePressed}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The scroll bar for a panel the work area has had to cap, drawn from the
                 palette's ScrollTrack and ScrollThumb so both heads draw one bar rather than
                 each choosing its own grey. The three numbers are the Linux panel's, stated
                 there for this head to match: 6 wide, 6 clear of the content, and a thumb no
                 shorter than 24 so very tall content still leaves something grabbable.

                 No arrow buttons, and the page strips are templated to a bare transparent
                 Border rather than hidden: a collapsed RepeatButton stops answering clicks,
                 and a click on the track either side of the thumb is a page, exactly as it is
                 on the Linux bar. The bar only ever appears on a display already short of
                 room, so it costs the content as little width as it can. -->
            <Style x:Key="PanelScrollBar" TargetType="ScrollBar">
                <Setter Property="Width" Value="{x:Static rendering:PanelMetrics.ScrollBarWidthDip}"/>

                <!-- MinWidth as well as Width: the stock vertical bar sets a MinWidth of the
                     system scroll-bar width, and a minimum outranks a width whatever the style
                     precedence says. Without this the bar comes out at the Windows default of
                     17 DIP, nearly three times the Linux one, in the one place on the panel
                     where width is scarce. -->
                <Setter Property="MinWidth" Value="{x:Static rendering:PanelMetrics.ScrollBarWidthDip}"/>
                <!-- The left margin is PanelMetrics.ScrollBarGapDip; a Thickness cannot be
                     built from a static double in XAML, so the figure is repeated here. -->
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{DynamicResource ScrollTrack}" CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinHeight="{x:Static rendering:PanelMetrics.ScrollThumbMinHeightDip}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource ScrollThumb}"
                                                            CornerRadius="3" SnapsToDevicePixels="True"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The viewport the sections move into once the panel has been capped
                 (PopupScroll). Templated rather than left to the stock ScrollViewer so the
                 bar above is the one that appears, and so the bar occupies an Auto column
                 beside the content instead of overlaying it. -->
            <Style x:Key="PanelScrollViewer" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Grid.Column="0"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                           Orientation="Vertical"
                                           Style="{StaticResource PanelScrollBar}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="PanelRoot" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="10" Padding="16">
        <!-- Named because a capped panel is laid out inside a scrolling viewport instead of
             directly in the border above (PopupScroll). -->
        <StackPanel x:Name="PanelBody">

            <!-- Header: title + freshness left, account right (ui-spec.md) -->
            <!-- Also the drag handle (DockedFlyout.MakeDragHandle). The header is the one band
                 of the panel with nothing on it to click, so a press here can mean "move me"
                 without taking a click away from anything.

                 Background="Transparent" is load-bearing: a panel with no background is not
                 hit-testable in the gaps between its children, so the handle would only respond
                 on the words themselves. Cursor says
                 the band is draggable before the user tries it, there is no other affordance,
                 since a borderless flyout has no title bar to imitate.

                 And the name is what a screen reader says in place of that cursor: without it
                 the band announces the app name, the freshness line and the account block, and
                 never that it is the thing the panel is moved by. The words come from
                 Presentation like every other word in the panel, so both heads say the same
                 one. -->
            <Grid x:Name="PanelHeader" Background="Transparent" Cursor="SizeAll"
                  AutomationProperties.Name="{x:Static panel:PanelHeaderView.MoveName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static panel:PanelHeaderView.AppName}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="UpdatedText" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="NameText" FontSize="12" FontWeight="SemiBold" TextAlignment="Right"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="EmailText" FontSize="11" TextAlignment="Right"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Border x:Name="TierBadge" Background="{DynamicResource BadgeBg}" CornerRadius="4"
                            Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Right">
                        <TextBlock x:Name="TierText" FontSize="10" Foreground="{DynamicResource BadgeText}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Off-plan warning: the plan % is true but not the whole story. The outer Grid is
                 what folds when the reader hides it, so the space above the banner goes too. -->
            <Grid x:Name="DivergenceBannerFold" Visibility="Collapsed">
                <Border x:Name="DivergenceBanner" Background="{DynamicResource WarnBg}" CornerRadius="6"
                        Margin="0,12,0,0">
                    <Grid>
                        <!-- 28 on the right keeps the sentences clear of the hide control. -->
                        <StackPanel Margin="10,8,28,8">
                            <TextBlock x:Name="DivergenceTitle" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarnText}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DivergenceDetail" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <!-- Every wording in this banner ends by sending the reader to Claude for
                                 the figure O-view will not state (rule 6). Issue #259 asked for the
                                 link that sentence implies, so the instruction is now the thing you
                                 click rather than a place to navigate to by hand. -->
                            <!-- WarnText, not the brand accent: AccentText is white, chosen for legibility
                                 ON AccentBg, and this link sits on WarnBg. WarnText is the pair already
                                 measured against this background, it is what the title above is drawn
                                 in, and the underline means the affordance does not rest on colour. -->
                            <TextBlock x:Name="DivergenceLink" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap">
                                <Hyperlink x:Name="DivergenceLinkAnchor"
                                           Foreground="{DynamicResource WarnText}"
                                           TextDecorations="Underline"
                                           RequestNavigate="OnUsageSettingsNavigate"/>
                            </TextBlock>
                        </StackPanel>
                        <Button x:Name="HideBannerButton" Style="{StaticResource BannerHideButton}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Why the figures read "unknown". A blank panel with no explanation cost
                 four rounds of support to diagnose; the app should state the reason. -->
            <Border x:Name="NoDataBanner" Background="{DynamicResource WarnBg}" CornerRadius="6"
                    Padding="10,8" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="NoDataTitle" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarnText}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NoDataDetail" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Your plan: its meters and the off-plan row that closes them, flat on the panel.
                 The block's own space follows the density, so it is set from PopupPlanBlock. -->
            <Border x:Name="PlanBlock">
                <StackPanel>
                    <local:LetterSpacedText x:Name="PlanBlockTitle" HorizontalAlignment="Left"
                                            TextElement.FontSize="{x:Static rendering:PanelMetrics.BlockTitleFontSize}"
                                            TextElement.FontWeight="SemiBold"
                                            TextElement.Foreground="{DynamicResource TextSecondary}"/>

                    <StackPanel Margin="0,4,0,0">
                        <!-- Session bar -->
                        <StackPanel x:Name="SessionMeter">
                            <Grid>
                                <TextBlock Text="{x:Static text:PanelText.SessionBarLabel}"
                                           FontSize="{x:Static rendering:PanelMetrics.MeterLabelFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="SessionPctText" HorizontalAlignment="Right"
                                           FontSize="{x:Static rendering:PanelMetrics.MeterLabelFontSize}"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <Grid x:Name="SessionBar" Height="{x:Static rendering:PanelMetrics.MeterBarHeightDip}" Margin="0,5,0,4">
                                <Border Background="{DynamicResource BarTrack}" CornerRadius="4"/>
                                <Border x:Name="SessionBarFill" CornerRadius="4" HorizontalAlignment="Left"/>
                            </Grid>
                            <TextBlock x:Name="SessionResetText" FontSize="{x:Static rendering:PanelMetrics.MeterResetFontSize}"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>

                        <!-- Weekly bar -->
                        <StackPanel x:Name="WeeklyMeter">
                            <!-- Three columns, not an overlay. The percentage is right-aligned in its own
                                 Auto column so it reserves its width, and the chip sits in the star column
                                 between them: the label and the figure both keep their space whatever the
                                 chip says, and an over-long chip is trimmed rather than drawn over the
                                 figure. Note the figure reads "51% used", not "51%", a chip budget worked
                                 out against the shorter string is about 30px too generous. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static text:PanelText.WeeklyBarLabel}"
                                           FontSize="{x:Static rendering:PanelMetrics.MeterLabelFontSize}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <Border x:Name="BoostChip" Grid.Column="1"
                                        Background="{DynamicResource BadgeBg}" CornerRadius="4"
                                        Padding="6,1" Margin="8,0,8,0" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" Visibility="Collapsed">
                                    <TextBlock x:Name="BoostChipText" FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource BadgeText}"/>
                                </Border>
                                <TextBlock x:Name="WeeklyPctText" Grid.Column="2"
                                           FontSize="{x:Static rendering:PanelMetrics.MeterLabelFontSize}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <Grid x:Name="WeeklyBar" Height="{x:Static rendering:PanelMetrics.MeterBarHeightDip}" Margin="0,5,0,4">
                                <Border Background="{DynamicResource BarTrack}" CornerRadius="4"/>
                                <Border x:Name="WeeklyBarFill" CornerRadius="4" HorizontalAlignment="Left"/>
                            </Grid>
                            <TextBlock x:Name="WeeklyResetText" FontSize="{x:Static rendering:PanelMetrics.MeterResetFontSize}"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>

                        <!-- A bar for each model with a weekly limit of its own (PopupModelMeters). Built in
                             code because how many there are comes from the data, and with none this draws
                             nothing and takes no room. -->
                        <StackPanel x:Name="ModelLimitMeters"/>

                        <!-- The off-plan row. The whole row is the hover target (issue #181), so a
                             reader asking "what is this number?" finds the answer wherever the eye
                             lands. Background="Transparent" is load-bearing: a panel with no
                             background has no hit-testing in the gaps between its children. -->
                        <StackPanel x:Name="OffPlanRow" Background="Transparent" Visibility="Collapsed">
                            <Border Height="1" Margin="0,6,0,0" Background="{DynamicResource PanelBorder}"
                                    Opacity="{x:Static rendering:PanelMetrics.SoftLineOpacity}" SnapsToDevicePixels="True"/>
                            <Grid Margin="0,9,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="OffPlanRowTitle" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   FontSize="{x:Static rendering:PanelMetrics.MeterLabelFontSize}"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <Border Background="{DynamicResource WarnBg}" CornerRadius="4" Padding="6,1"
                                                Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="OffPlanRowBadge" FontSize="10" Foreground="{DynamicResource WarnText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="OffPlanRowCaption" TextWrapping="Wrap"
                                               FontSize="{x:Static rendering:PanelMetrics.OffPlanCaptionFontSize}"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="OffPlanRowValue" FontWeight="SemiBold" TextAlignment="Right"
                                               FontSize="{x:Static rendering:PanelMetrics.OffPlanFigureFontSize}"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="OffPlanRowCoverage" TextAlignment="Right"
                                               FontSize="{x:Static rendering:PanelMetrics.OffPlanCaveatFontSize}"
                                               Foreground="{DynamicResource WarnText}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The one line between the blocks: soft, because on a flat surface a
                 full-strength rule reads as a box. -->
            <Border Height="1" Background="{DynamicResource PanelBorder}"
                    Opacity="{x:Static rendering:PanelMetrics.SoftLineOpacity}" SnapsToDevicePixels="True"/>

            <!-- On this machine: the chart, the table and the footer, flat on the panel. The
                 block's own space follows the density, so it is set from PopupLocalBlock. -->
            <Grid>
            <!-- The hover cue's outline: the extent of what a press turns over. Over the block, so
                 it adds no height, and its strength is on the brush (PopupLocalBlock). -->
            <Border x:Name="LocalBlockCue" Margin="-6" BorderThickness="1" CornerRadius="6"
                    Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="LocalBlock" Background="Transparent">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <local:LetterSpacedText x:Name="LocalBlockTitle" HorizontalAlignment="Left"
                                                    TextElement.FontSize="{x:Static rendering:PanelMetrics.BlockTitleFontSize}"
                                                    TextElement.FontWeight="SemiBold"
                                                    TextElement.Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="LocalBlockSubtitle" Margin="0,1,0,0"
                                       FontSize="{x:Static rendering:PanelMetrics.BlockSubtitleFontSize}"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <Button x:Name="FaceFlipTag" Style="{StaticResource FlipTagButton}"/>
                    </Grid>

                    <!-- One cell, so the two faces crossfade in the same place; the block's height
                         is pinned on it while they turn over (PopupLocalBlock). -->
                    <Grid x:Name="LocalFaces">
                    <StackPanel x:Name="LocalTotalsFace" VerticalAlignment="Top">
                        <!-- Drawn in code, against its laid-out width and the density's height. -->
                        <Canvas x:Name="GraphHost" HorizontalAlignment="Stretch"/>

                        <Border x:Name="LocalChartLine" Height="1" Background="{DynamicResource PanelBorder}"
                                Opacity="{x:Static rendering:PanelMetrics.SoftLineOpacity}" SnapsToDevicePixels="True"/>

                        <!-- Built in code: Output and Overall differ in their rows and columns, and a
                             row's cells follow what the view model hands over. -->
                        <Grid x:Name="LocalTotalsTable"/>
                    </StackPanel>

                    <!-- The other face of the block: the two doughnuts and a row per model, built
                         in code from the view model, as the totals table is. -->
                    <StackPanel x:Name="LocalModelFace" VerticalAlignment="Top" Visibility="Collapsed">
                        <Grid x:Name="LocalDoughnuts"/>
                        <Grid x:Name="LocalModelTable"/>
                    </StackPanel>
                    </Grid>

                    <!-- What qualifies the window's figures, partial history or an unpriced model,
                         flush right so it ends beneath the 31-day figures it is about (rule 6). -->
                    <TextBlock x:Name="LocalWindowCaveat" FontSize="10" Margin="0,4,0,0"
                               TextWrapping="Wrap" TextAlignment="Right"
                               Foreground="{DynamicResource WarnText}" Visibility="Collapsed"/>

                    <!-- Scope note. The plan meters above and the figures here measure DIFFERENT
                         things: the meters cover all Claude usage, this block only usage that
                         leaves a Claude Code transcript. A Desktop-only user therefore sees a
                         non-zero session % beside 0 tokens, and a bare "0" reads as "you used
                         nothing" rather than "this counts something else". -->
                    <TextBlock x:Name="TokenScopeNote" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>

                    <Grid x:Name="LocalFooter">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- The one caveat for the whole block: which surfaces these figures are
                             made of, and which are not counted. -->
                        <TextBlock x:Name="LocalFooterCaveat" TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontSize="{x:Static rendering:PanelMetrics.FooterFontSize}"
                                   Foreground="{DynamicResource TextMuted}"/>

                        <!-- RadioButtons rather than ToggleButtons: the two measures are mutually
                             exclusive, and the group gives arrow-key traversal and the correct
                             accessibility role without a line of code. -->
                        <Border Grid.Column="1" Background="{DynamicResource TileBg}" CornerRadius="4" Padding="2"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <!-- The lit segment: one element that moves, placed from code because
                                     where it goes is measured off the segments. -->
                                <Border x:Name="MeasureHighlight" HorizontalAlignment="Left" CornerRadius="3"
                                        Background="{DynamicResource BarTrack}" SnapsToDevicePixels="True"
                                        IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MeasureOutput" GroupName="LocalMeasure"
                                                 Style="{StaticResource ViewSwitchButton}"/>
                                    <RadioButton x:Name="MeasureOverall" GroupName="LocalMeasure"
                                                 Style="{StaticResource ViewSwitchButton}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            </Grid>

        </StackPanel>
    </Border>
</Window>
