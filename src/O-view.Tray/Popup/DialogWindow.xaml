<Window x:Class="OView.Tray.Popup.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True" AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandArc" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F4A17A" Offset="0"/>
            <GradientStop Color="#D9603A" Offset="1"/>
        </LinearGradientBrush>

        <!-- Primary action: brand accent fill, white label. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBg}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action: outlined, so only one thing on the dialog is loud. -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="10" Padding="18,16">
        <StackPanel>

            <!-- Same brand mark and wordmark as the tray menu, so a dialog is visibly
                 from the same application rather than a system box wearing its title. -->
            <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" Stroke="{StaticResource BrandArc}" StrokeThickness="2.5"/>
                    <Ellipse Width="5.5" Height="5.5" Fill="{StaticResource BrandArc}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" Margin="25,10,0,0"
                       LineHeight="18" Foreground="{DynamicResource TextSecondary}"/>

            <TextBlock x:Name="DetailText" FontSize="11" TextWrapping="Wrap" Margin="25,7,0,0"
                       Foreground="{DynamicResource TextMuted}" Visibility="Collapsed"/>

            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                    <TextBlock x:Name="CancelLabel" FontSize="12"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Button>
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsDefault="True">
                    <TextBlock x:Name="ConfirmLabel" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}"/>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
