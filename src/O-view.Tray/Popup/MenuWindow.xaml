<Window x:Class="OView.Tray.Popup.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="clr-namespace:OView.Presentation.Text;assembly=O-view.Presentation"
        xmlns:panel="clr-namespace:OView.Presentation.Panel;assembly=O-view.Presentation"
        Width="272" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <!-- The brand arc, shared with both dialogs (Brand.xaml). -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Brand.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- One row = one Button. Buttons rather than bare Borders so rows keep keyboard
             focus, Space/Enter activation and the pressed state for free; the template
             strips the chrome down to a rounded hover fill. -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource RowPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkmark drawn as a Path, not a font glyph: Segoe Fluent Icons is not on
             every supported build and a missing glyph renders as tofu. -->
        <Style x:Key="RowCheck" TargetType="Path">
            <Setter Property="Data" Value="M0,4.4 L3.5,7.9 L9.8,1.1"/>
            <Setter Property="Stroke" Value="{StaticResource BrandArc}"/>
            <Setter Property="StrokeThickness" Value="1.9"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- The threshold selector, sitting inline on the Notify row. A pill rather than a
             system ComboBox: a ComboBox drops a Popup, and a Popup lives in its own HWND
             outside this window's visual tree, so it would appear in no menu-samples render
             at all, and the surface with the app's worst regression record would be the one
             surface that could not be verified from an image. -->
        <Style x:Key="SelectorPill" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource TileBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background"
                                        Value="{DynamicResource TileHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="Background"
                                        Value="{DynamicResource TileHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background"
                                        Value="{DynamicResource TilePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One choice in the opened list. Shorter than a menu row so the group reads as
             belonging to the row above it rather than as three more top-level items. -->
        <Style x:Key="OptionRow" TargetType="Button" BasedOn="{StaticResource MenuRow}">
            <Setter Property="Height" Value="28"/>
        </Style>

        <!-- The selected marker: a filled dot, deliberately NOT the row checkmark. A tick
             means "this setting is on"; these three are one value out of three, and reusing
             the tick would read as three independent toggles. -->
        <Style x:Key="OptionMark" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="{StaticResource BrandArc}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="10" Padding="6">
        <!-- StackPanel + SizeToContent="Height": adding a row needs no measurement
             anywhere else, and the docked placement re-reads ActualHeight on every
             open, so a taller menu still clears the taskbar (issue #33). -->
        <StackPanel>

            <!-- Header. The flyout opens in a fixed corner rather than under the cursor,
                 so it says what it is: detached placement without a label reads as a
                 stray window. -->
            <Grid Margin="8,4,8,7">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="15" Height="15" VerticalAlignment="Center">
                        <Ellipse Width="15" Height="15" Stroke="{StaticResource BrandArc}"
                                 StrokeThickness="2.4"/>
                        <Ellipse Width="5" Height="5" Fill="{StaticResource BrandArc}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{x:Static panel:PanelHeaderView.AppName}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <TextBlock x:Name="VersionText" FontSize="10" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
            </Grid>

            <!-- Top of the list: someone opening the menu for this has a panel sitting somewhere
                 they cannot get it back from, so it must not be something to hunt for. There is
                 no row above it to follow, the tray icon's own click is what opens the panel on
                 this head.

                 Always present, unlike the rows below that appear only when they have something
                 to say: those state a condition ("the refresh has stopped itself") or a
                 capability ("this build can self-install"), and a row claiming one it does not
                 have would be a claim about the machine. This one is a command, like "Copy
                 diagnostics", it is a no-op with nothing saved, and hiding it until the panel
                 has already been dragged hides it exactly until it is needed. -->
            <Button x:Name="ResetPanelRow" Style="{StaticResource MenuRow}">
                <TextBlock Text="{x:Static text:MenuText.ResetPanelPositionRow}"
                           Style="{StaticResource RowLabel}" Margin="22,0,0,0"/>
            </Button>

            <Button x:Name="StartupRow" Style="{StaticResource MenuRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="StartupCheck" Grid.Column="0" Style="{StaticResource RowCheck}"/>
                    <TextBlock Grid.Column="1" Text="{x:Static text:MenuText.RunAtStartupRow}"
                               Style="{StaticResource RowLabel}"/>
                </Grid>
            </Button>

            <!-- Directly beneath "Run at startup", as issue #140 asks. Collapsed entirely on
                 a build that cannot self-install (portable exe, .deb, tarball) rather than
                 shown disabled: a row implying a behaviour the build cannot perform is a
                 claim about the machine that is not true. See ADR-0009's amendment. -->
            <Button x:Name="UpdateAutoRow" Style="{StaticResource MenuRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="UpdateAutoCheck" Grid.Column="0" Style="{StaticResource RowCheck}"/>
                    <TextBlock Grid.Column="1" Text="{x:Static text:MenuText.UpdateAutomaticallyRow}"
                               Style="{StaticResource RowLabel}"/>
                </Grid>
            </Button>

            <Button x:Name="NotifyRow" Style="{StaticResource MenuRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="NotifyCheck" Grid.Column="0" Style="{StaticResource RowCheck}"/>
                    <TextBlock x:Name="NotifyLabel" Grid.Column="1" Text="{x:Static text:MenuText.NotifyPrefix}"
                               Style="{StaticResource RowLabel}"/>

                    <!-- Nested inside the row Button on purpose: the whole row still toggles
                         the notification on and off, and only this pill opens the list. Click
                         is a bubbling routed event, so the handler marks it handled or the
                         row above would toggle every time the pill was pressed. -->
                    <Button x:Name="ThresholdPill" Grid.Column="2" Margin="6,0,6,0"
                            Style="{StaticResource SelectorPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThresholdText" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <Path x:Name="ThresholdChevron" Data="M0,0 L4,4 L8,0" Margin="6,1,0,0"
                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ChevronRotation" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="NotifySuffix" Grid.Column="3" Style="{StaticResource RowLabel}"/>
                </Grid>
            </Button>

            <!-- The opened list. Inline in the card rather than a floating Popup, so it is
                 part of the visual tree the verification renders capture, and so nothing can
                 take activation away from the flyout and dismiss it mid-choice (issue #11).
                 The card is SizeToContent, so opening this grows it, MenuWindow re-docks
                 afterwards, which is what keeps the group clear of the taskbar. -->
            <StackPanel x:Name="ThresholdOptions" Visibility="Collapsed" Margin="0,1,0,3">
                <Button x:Name="Threshold70" Style="{StaticResource OptionRow}" Tag="70">
                    <Grid Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Mark70" Grid.Column="0" Style="{StaticResource OptionMark}"/>
                        <TextBlock x:Name="Label70" Grid.Column="1" Style="{StaticResource RowLabel}"/>
                    </Grid>
                </Button>
                <Button x:Name="Threshold80" Style="{StaticResource OptionRow}" Tag="80">
                    <Grid Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Mark80" Grid.Column="0" Style="{StaticResource OptionMark}"/>
                        <TextBlock x:Name="Label80" Grid.Column="1" Style="{StaticResource RowLabel}"/>
                    </Grid>
                </Button>
                <Button x:Name="Threshold90" Style="{StaticResource OptionRow}" Tag="90">
                    <Grid Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Mark90" Grid.Column="0" Style="{StaticResource OptionMark}"/>
                        <TextBlock x:Name="Label90" Grid.Column="1" Style="{StaticResource RowLabel}"/>
                    </Grid>
                </Button>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource PanelBorder}" Margin="8,5,8,5"/>

            <!-- The weekly reset the user read off Claude, which outranks the one O-view
                 derives from a ~10 hour overnight bracket (issue #186). The trailing label
                 says which is in effect, so the row states the current answer rather than
                 only offering to change it. -->
            <Button x:Name="WeeklyResetRow" Style="{StaticResource MenuRow}">
                <!-- Two real columns, not overlaid children: a single-cell Grid lets the
                     label and the trailing value draw over each other, which is exactly what
                     "Weekly reset time…derived" looked like. The value keeps its width and
                     the label gives way. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static text:MenuText.WeeklyResetRow}"
                               Style="{StaticResource RowLabel}"
                               Margin="22,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="WeeklyResetValue" Grid.Column="1" Margin="0,0,4,0"
                               VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextMuted}"/>
                </Grid>
            </Button>

            <Button x:Name="ResumeRefreshRow" Style="{StaticResource MenuRow}">
                <TextBlock x:Name="ResumeRefreshLabel" Style="{StaticResource RowLabel}" Margin="22,0,0,0"/>
            </Button>

            <Button x:Name="DiagnosticsRow" Style="{StaticResource MenuRow}">
                <TextBlock Text="{x:Static text:MenuText.CopyDiagnosticsRow}"
                           Style="{StaticResource RowLabel}" Margin="22,0,0,0"/>
            </Button>

            <Button x:Name="UpdatesRow" Style="{StaticResource MenuRow}">
                <TextBlock Text="{x:Static text:MenuText.CheckForUpdatesRow}"
                           Style="{StaticResource RowLabel}" Margin="22,0,0,0"/>
            </Button>

            <Button x:Name="ExitRow" Style="{StaticResource MenuRow}">
                <TextBlock Text="{x:Static text:MenuText.ExitRow}"
                           Style="{StaticResource RowLabel}" Margin="22,0,0,0"/>
            </Button>

        </StackPanel>
    </Border>
</Window>
